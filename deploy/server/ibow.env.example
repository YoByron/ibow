# Settings for ibow.service and update.sh; install.sh copies this to ~/apps/ibow/ibow.env. Plain KEY=VALUE lines only.
# The server listens on loopback only; the tunnel (or a proxy) is what the world reaches.
HOST=127.0.0.1
PORT=8790
# One proxy (the tunnel) sits in front of ibow.
TRUST_PROXY=1
# The demo's sample business: tea-house, coffee-cart, food-truck, bakery or service-desk.
IBOW_DEMO_SAMPLE=tea-house
# Where update.sh pulls from, and which branch. It builds a commit only when its GitHub checks have all passed.
IBOW_REPO=https://github.com/YoByron/ibow
IBOW_BRANCH=main
