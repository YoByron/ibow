# Copy to .env and fill in. .env is gitignored; never commit real values.

# These settings are for the plain Node server. On Cloudflare they are wrangler vars and secrets: docs/install.md.
# HTTP port the server listens on, and the address: 127.0.0.1 (default) is this machine only; 0.0.0.0 lets phones
# on the same Wi-Fi reach it (or a reverse proxy on another host)
PORT=3000
HOST=127.0.0.1
# Directory holding business.json, catalog.json and stations.json (a sample works too: ./samples/tea-house)
CONFIG_DIR=./config
# Directory for the SQLite database file (ibow.db); created if missing
DATA_DIR=./data
# Hash of the owner PIN: run `npm run hash-pin`, type the PIN, paste the output here. Never store the PIN itself.
OWNER_PIN_HASH=
# Optional: hash of the system admin's own PIN (same `npm run hash-pin`; use a different PIN from the owner's). The admin
# signs in at /admin to see the install's health and flip system switches. Leave empty and nobody can sign in as admin.
ADMIN_PIN_HASH=
# UPI ID that customers pay to, and the payee name shown in their UPI app (default: the business name).
# INR businesses only; leave UPI_VPA empty to offer only "pay at the counter". Example: yourbusiness@upi
UPI_VPA=
UPI_PAYEE_NAME=
# Reverse proxies in front of ibow (nginx, Caddy, a load balancer): 0 trusts none and uses the socket address.
# Set to the number of proxies only when every request passes through them, or clients can fake their address.
TRUST_PROXY=0

# AI business analyst (optional; off while AI_BASE_URL and AI_MODEL are empty). The owner asks questions on the
# dashboard; the server sends the model anonymous figures only (no customer names, no reviews). Any server speaking
# the OpenAI-compatible Chat Completions API works: OpenAI, Gemini's OpenAI-compatible endpoint, OpenRouter, Groq, or a
# local Ollama, LM Studio or llama.cpp server. A free model on this machine with Ollama: AI_BASE_URL=http://127.0.0.1:11434/v1 and
# AI_MODEL=llama3.2 (after `ollama pull llama3.2`), no key. A hosted provider: its https:// base URL ending in /v1,
# a model name it offers, and your own key. The key stays on the server: never in a browser, a log or the database.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Seconds to wait for an answer (1 to 290, default 30; Node's fetch stops at 300); a local model on a small machine
# needs more, and Ollama a context of 8192 tokens (OLLAMA_CONTEXT_LENGTH=8192)
AI_TIMEOUT_SECONDS=
